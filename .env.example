# Do not put real keys in version control or chat. Prefer environment variables.
PROOFTRAIL_RPC_URL=https://testnet-rpc.monad.xyz
# Set to the address verified in artifacts/monad-deployment.json
PROOFTRAIL_CONTRACT=
# Public deployment must explicitly list its host names, without scheme or port.
PROOFTRAIL_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional CLI-only dedicated TESTNET account; server never signs in monad mode.
PROOFTRAIL_PRIVATE_KEY=
